# DB credentials for local development. DO NOT COMMIT REAL CREDENTIALS.
POSTGRES_USER=transact
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=transact
POSTGRES_HOST=db
POSTGRES_PORT=25060
# Optional: set to "Require" when using a managed Postgres (e.g. DigitalOcean).
# POSTGRES_SSLMODE=Require


ASPNETCORE_ENVIRONMENT=Development

# ---------- Web (nginx) ----------
# Host port the SPA is published on.
WEB_PORT=8080
# Origin the browser uses to reach the SPA (added to the API CORS allowlist).
PUBLIC_ORIGIN=http://localhost:8080