# Copy this file to `.env` and fill in real values. Do NOT commit `.env`.
# These variables are loaded by:
#   * docker-compose (interpolated into service env)
#   * the API at startup via DotNetEnv (when running `dotnet run` / `dotnet watch`)

# ---------- Database ----------
# Used by the local Postgres container AND by the API to build the
# ConnectionStrings__DefaultConnection if one is not supplied directly.
POSTGRES_USER=transact
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=transact
# Hostname:
#   - "db"        when the API runs inside docker-compose
#   - "localhost" when the API runs on the host (`dotnet watch`) against the
#                 Postgres container's published port
POSTGRES_HOST=db
POSTGRES_PORT=25060
# Optional: set to "Require" when using a managed Postgres (e.g. DigitalOcean).
# POSTGRES_SSLMODE=Require

# ---------- API ----------
ASPNETCORE_ENVIRONMENT=Development

# ---------- Web (nginx) ----------
# Host port the SPA is published on.
WEB_PORT=8080
# Origin the browser uses to reach the SPA (added to the API CORS allowlist).
PUBLIC_ORIGIN=http://localhost:8080